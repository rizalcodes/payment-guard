# Payment Guard — contoh konfigurasi. SALIN ke .env dan isi di mesin sendiri.
# File ini TIDAK BOLEH memuat nilai rahasia. .env di-gitignore.
#
# URL database per proses diisi otomatis oleh:  guard db bootstrap-roles
# Jangan mencampur URL antar proses (lihat Arsitektur v1.1 bagian 2).

# --- URL database per proses runtime (rahasia, diisi bootstrap-roles) ---
GUARD_DB_URL=
APPROVER_DB_URL=
EXECUTOR_DB_URL=
WATCHER_DB_URL=
RECONCILER_DB_URL=

# MIGRATOR_DB_URL TIDAK ada di sini dengan sengaja. Role migrator adalah
# pemilik semua objek dan bisa melepas trigger append-only (Security v1.1
# RR-2), jadi URL-nya hidup di file terpisah `.env.migrator` supaya ia tidak
# ikut termuat ke proses runtime. Lihat .env.migrator.example.

# URL admin untuk `guard db bootstrap-roles` TIDAK ditaruh di sini dengan sengaja.
# Berikan lewat environment variable sementara (PAYMENT_GUARD_ADMIN_DB_URL) atau
# biarkan kosong supaya perintah meminta lewat prompt tersembunyi.
# Lihat Security v1.1 I6.

# --- Mandate dan kunci (M2 dan sesudahnya; kosong di M0) ---
GUARD_MANDATE_PATH=
GUARD_SIGNING_KEY_PATH=
GUARD_PUBLIC_KEYS_PATH=guard_public.json
EXECUTOR_KEY_PATH=

# --- Chain (M5 dan sesudahnya; kosong di M0) ---
# RPC_URL memuat API key penyedia: rahasia.
RPC_URL=
CHAIN_ID=84532
USDC_ADDRESS=
CONFIRMATIONS=12
SCAN_BATCH_SIZE=2000
REORG_LOOKBACK=64

# --- Eval (M8; kosong di M0) ---
EVAL_API_KEY=
