# Payment Guard — contoh konfigurasi. SALIN ke .env dan isi di mesin sendiri.
# File ini TIDAK BOLEH memuat nilai rahasia. .env di-gitignore.
#
# URL database per proses diisi otomatis oleh:  guard db bootstrap-roles
# Jangan mencampur URL antar proses (lihat Arsitektur v1.1 bagian 2).

# --- URL database per proses runtime (rahasia, diisi bootstrap-roles) ---
GUARD_DB_URL=
APPROVER_DB_URL=
EXECUTOR_DB_URL=
WATCHER_DB_URL=
RECONCILER_DB_URL=

# MIGRATOR_DB_URL TIDAK ada di sini dengan sengaja. Role migrator adalah
# pemilik semua objek dan bisa melepas trigger append-only (Security v1.1
# RR-2), jadi URL-nya hidup di file terpisah `.env.migrator` supaya ia tidak
# ikut termuat ke proses runtime. Lihat .env.migrator.example.

# URL admin untuk `guard db bootstrap-roles` TIDAK ditaruh di sini dengan sengaja.
# Berikan lewat environment variable sementara (PAYMENT_GUARD_ADMIN_DB_URL) atau
# biarkan kosong supaya perintah meminta lewat prompt tersembunyi.
# Lihat Security v1.1 I6.

# --- Mandate dan kunci (M2 dan sesudahnya; kosong di M0) ---
# GUARD_SIGNING_KEY_PATH HARUS menunjuk ke luar akar repo. Guard menolak start
# bila path-nya (setelah resolve) berada di dalam repo, supaya bahan kunci tidak
# pernah bisa ikut ter-commit. Contoh di Windows:
#   GUARD_SIGNING_KEY_PATH=C:\Users\<nama>\payment-guard-secrets\guard_signing.json
# Buat pasangan kuncinya dengan:
#   guard keygen --signing-key-file <path di luar repo> --public-keys-file guard_public.json
GUARD_MANDATE_PATH=
GUARD_SIGNING_KEY_PATH=
# Registri kunci publik boleh di dalam repo: isinya tidak rahasia.
GUARD_PUBLIC_KEYS_PATH=guard_public.json
# EXECUTOR_KEY_PATH adalah kunci wallet milik Executor sendiri, dan ia juga
# HARUS menunjuk ke luar akar repo. Executor memegang kunci publik Guard saja;
# ia tidak pernah membaca GUARD_SIGNING_KEY_PATH. Bentuk berkasnya:
#   {"address": "0x...", "private_key": "0x<64 hex>"}
# Cara membuatnya ada di scripts/demo_execute.md langkah 2.
EXECUTOR_KEY_PATH=

# --- Guard runtime (M3; opsional, ada defaultnya) ---
# Selang heartbeat lock sesi, 1..60 detik. Default 5.
GUARD_HEARTBEAT_SECONDS=
# Batas tunggu lock dan statement, 100..600000 ms. Default 5000. Batas ini yang
# membuat "database tidak bisa dihubungi" berarti gagal cepat, bukan menggantung.
GUARD_LOCK_TIMEOUT_MS=

# --- Chain (M5 dan sesudahnya) ---
# RPC_URL memuat API key penyedia: rahasia. Hanya http:// dan https:// yang
# diterima. Executor tidak pernah mencetaknya utuh, hanya skema dan host-nya,
# karena kunci API biasa diletakkan di path atau query. Kosongkan untuk memakai
# RPC publik Base Sepolia: https://sepolia.base.org
RPC_URL=
# Hanya 84532 (base-sepolia) yang diterima; nilai lain menolak start.
CHAIN_ID=84532
# Kosongkan untuk memakai alamat USDC testnet Base Sepolia yang sudah
# diverifikasi ke dokumentasi Circle. Apa pun yang diisi di sini tetap diperiksa:
# Executor memanggil decimals() saat start dan menolak jalan bila bukan 6.
USDC_ADDRESS=
# Batas tunggu lock dan statement Executor, 100..600000 ms. Default 5000.
EXECUTOR_LOCK_TIMEOUT_MS=
# --- Watcher (M6) ---
# Kedalaman konfirmasi sebelum settlement boleh menjadi `final`. 1..1000.
CONFIRMATIONS=12
# Lebar satu rentang eth_getLogs. Node publik menolak rentang besar. 1..10000.
SCAN_BATCH_SIZE=2000
# Jendela mundur K untuk memeriksa ulang baris yang sudah `final`. HARUS lebih
# besar dari CONFIRMATIONS, kalau tidak reorg yang lebih dalam dari kedalaman
# konfirmasi tidak akan pernah terlihat; loader menolak kalau tidak.
REORG_LOOKBACK=64
# Alamat wallet Executor, BUKAN kuncinya. Watcher menyaring log Transfer per
# pengirim (PRD v2 bagian 10) dan karena itu harus tahu alamat ini; ia tidak
# boleh membaca berkas kunci dan tidak punya hak baca ke executions.
# Tanpa default dengan sengaja: default apa pun berarti memantau wallet yang
# salah dalam diam. Isi dengan field "address" dari berkas kunci Executor.
EXECUTOR_WALLET_ADDRESS=
# Jeda antar siklus `guard watch --loop`, dalam detik. 1..3600. Default 15.
WATCHER_INTERVAL_SECONDS=
# Batas tunggu lock dan statement Watcher, 100..600000 ms. Default 5000.
WATCHER_LOCK_TIMEOUT_MS=

# --- Reconciler (M6) ---
# Berapa lama execution yang sudah disiarkan boleh belum punya settlement
# `final` sebelum dicatat `executed_not_settled`. 60..604800 detik.
# Default 3600. Pendek berarti alarm palsu setiap kali chain melambat;
# panjang berarti pembayaran yang hilang baru terlihat besok.
RECONCILE_DEADLINE_SECONDS=
# Batas tunggu lock dan statement Reconciler, 100..600000 ms. Default 5000.
RECONCILER_LOCK_TIMEOUT_MS=

# --- Eval (M8; kosong di M0) ---
EVAL_API_KEY=
