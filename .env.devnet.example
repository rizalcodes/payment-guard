# Templat konfigurasi DEVNET LOKAL. Salin ke .env.devnet dan isi.
#
#     cp .env.devnet.example .env.devnet
#
# .env.devnet TER-IGNORE git (lewat `.env.*` di .gitignore). Jangan pernah
# meng-commit-nya, dan jangan pernah memakai nilai apa pun dari berkas ini di
# jaringan sungguhan — termasuk testnet publik.
#
# ===========================================================================
# INI DEVNET LOKAL, BUKAN TESTNET.
#
# Chain id 31337 adalah chain Anvil di mesin ini saja. Ia tidak punya
# hubungan apa pun dengan Base Sepolia (84532), dan token di dalamnya BUKAN
# USDC. Lihat docs/devnet.md.
#
# KUNCI DI BAWAH ADALAH KUNCI DEFAULT ANVIL, DAN ITU PUBLIK. Mnemonic-nya
# ("test test test ... junk") diterbitkan di dokumentasi Foundry dan dipakai
# setiap pengembang di dunia. Alamat-alamat itu dikuras bot dalam hitungan
# detik di jaringan apa pun yang punya nilai. Berkas ini aman HANYA karena
# chain-nya hidup dan mati di 127.0.0.1.
# ===========================================================================

# --- Database devnet: cluster KETIGA di port 5436 -------------------------
# BUKAN 5434 (operator) dan BUKAN 5435 (tes). Lima URL runtime diisi oleh
# `guard bootstrap-roles`; biarkan kosong sebelum skrip devnet dijalankan.
GUARD_DB_URL=
APPROVER_DB_URL=
EXECUTOR_DB_URL=
WATCHER_DB_URL=
RECONCILER_DB_URL=

# --- Berkas mandate dan kunci ---------------------------------------------
# Path di luar repo. Skrip devnet mengisinya.
GUARD_MANDATE_PATH=
GUARD_SIGNING_KEY_PATH=
GUARD_PUBLIC_KEYS_PATH=
EXECUTOR_KEY_PATH=

GUARD_HEARTBEAT_SECONDS=5
GUARD_LOCK_TIMEOUT_MS=3000

# --- Chain: devnet lokal --------------------------------------------------
# Anvil di 127.0.0.1:8545, chain id 31337.
RPC_URL=http://127.0.0.1:8545
CHAIN=devnet-local
CHAIN_ID=31337

# Alamat kontrak token UJI, bukan USDC. Diisi skrip devnet setelah deploy;
# alamatnya berubah setiap devnet dibangun ulang.
USDC_ADDRESS=

EXECUTOR_LOCK_TIMEOUT_MS=3000

# --- Watcher --------------------------------------------------------------
# Kelima setelan di bawah SENGAJA sama dengan bawaan `config.py`
# (DEFAULT_CONFIRMATIONS dan kawan-kawan), bukan angka yang dipilih sendiri.
#
# Sebelumnya templat ini memuat 20, 2, dan 60 — nilai yang tidak pernah
# berlaku, karena `.env.devnet` dibuat `bootstrap-roles` dan kelima kunci ini
# tidak pernah ada di dalamnya. Templat yang menjanjikan setelan yang tidak
# berlaku lebih buruk daripada templat yang diam.
#
# `RECONCILE_DEADLINE_SECONDS=60` khususnya berbahaya: ia bisa memunculkan
# `executed_not_settled` palsu di skenario jalur bahagia, sebelum Watcher
# sempat menaikkan settlement menjadi `final`.
#
# Di devnet blok dimajukan dengan anvil_mine, jadi 12 konfirmasi datang dalam
# hitungan milidetik.
CONFIRMATIONS=12
SCAN_BATCH_SIZE=1000
REORG_LOOKBACK=64

# Alamat wallet Executor di devnet. Diisi skrip devnet dari berkas kunci.
EXECUTOR_WALLET_ADDRESS=

WATCHER_INTERVAL_SECONDS=15
WATCHER_LOCK_TIMEOUT_MS=3000

RECONCILE_DEADLINE_SECONDS=3600
RECONCILER_LOCK_TIMEOUT_MS=3000
