# --- Rahasia: jangan pernah di-commit ---
# .env          -> lima URL runtime
# .env.migrator -> MIGRATOR_DB_URL (role pemilik objek), sengaja terpisah
# .env.test     -> URL admin cluster TES saja; tidak pernah dibaca runtime
.env
.env.*
!.env.example
!.env.migrator.example
!.env.test.example
# .env.devnet -> devnet LOKAL (chain id 31337). Ter-ignore oleh `.env.*` di
# atas; hanya templatnya yang di-track. Berkas itu memuat kunci default Anvil,
# yang PUBLIK — lihat docs/devnet.md.
!.env.devnet.example

# File kunci (tanda tangan Guard, wallet Executor)
*.key
*.pem
*.p8
*.pk8
*.jwk
*.keystore
secrets/
keys/
*_private.json
guard_signing*.json
executor_wallet*.json

# --- Hasil eval (bisa memuat transkrip mentah) ---
evals/results/

# --- Artefak build kontrak devnet (forge) ---
# Bytecode dan ABI dibangun ulang dari sumber dengan solc yang dipin di
# contracts/foundry.toml, jadi ia tidak perlu ikut repo.
contracts/out/
contracts/cache/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

mandates/
