# Payment Guard — konfigurasi harness TES. SALIN ke .env.test.
#
# Berkas ini hanya dibaca tes integrasi. Ia TIDAK pernah dibaca kode runtime,
# dan harness TIDAK pernah membaca .env atau .env.migrator — keduanya milik
# instalasi operator, dan harness yang bisa membacanya adalah harness yang bisa
# merusaknya.
#
# Jalankan cluster tes lebih dulu (profile `test`, bukan cluster operator):
#
#     docker compose --profile test up -d postgres_test
#
# Harness MENOLAK jalan kecuali ketiganya benar:
#   * nama database berakhiran  _test
#   * host loopback             127.0.0.1, localhost, atau ::1
#   * port ditulis eksplisit dan BUKAN 5434 (itu cluster operator)
#
# Tidak ada URL bawaan dengan sengaja. Versi sebelumnya punya satu, dan ia
# menunjuk tepat ke database operator di port 5434.

PAYMENT_GUARD_TEST_ADMIN_DB_URL=postgresql://guard_admin:devonly_not_a_secret@127.0.0.1:5435/payment_guard_test
